PORT=8080
SCYLLA_HOSTS=scylla-1,scylla-2,scylla-3
SCYLLA_KEYSPACE=shortener
SCYLLA_DISABLE_INITIAL_HOST_LOOKUP=false
REDIS_ADDR=localhost:6379
BASE_URL=http://localhost:8080
PING_DATABASE_FREQUENCY_IN_MILLIS=5000
CACHE_DEFAULT_TTL_IN_MILLIS=3600000

FC_ENABLE=1
FC_TEMPLATES=./krakend/templates
FC_SETTINGS=./krakend/settings
FC_PARTIALS=./krakend/partials
FC_OUT=./krakend/krakend_compiled.json